# ==============================================================================
# SupportNova Production Environment Configuration Template (.env.example)
# Copy this file to .env before starting services in production.
# IMPORTANT: Never commit actual secret keys or credentials to repository.
# ==============================================================================

# Application Environment (production / staging / development)
ENVIRONMENT=production

# FastAPI Documentation Toggle (set true to enable Swagger /docs in production)
ENABLE_DOCS=false

# Port Configuration (Render sets $PORT automatically for backend services)
PORT=8000

# Anthropic Claude API Key (Required for GenAI Pipeline 1 resolution)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Database Connection String
# Format: postgresql://user:password@hostname:port/dbname
DATABASE_URL=postgresql://supportnova_user:your_secure_db_password_here@postgres:5432/supportnova_production_db

# JWT Authentication Secret Key (Cryptographically secure random string)
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# JWT Algorithm (Default: HS256)
ALGORITHM=HS256

# CORS Allowed Origins (Comma-separated list of allowed frontend domain URLs)
CORS_ALLOWED_ORIGINS=https://supportnova-frontend.onrender.com,https://supportnova.onrender.com,http://localhost:3000

# Database Password (for docker-compose postgres container)
POSTGRES_USER=supportnova_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=supportnova_production_db
